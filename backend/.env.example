# Valeurs de développement ; aucune clé secrète dans Git.
# Variables lues dans l'environnement du processus. Pour charger ce fichier :
# uvicorn le_loup_api.main:app --env-file backend/.env
LE_LOUP_DART=C:/bibliotheque/flutter/bin/cache/dart-sdk/bin/dart.exe
LE_LOUP_MAX_ROOMS=16
LE_LOUP_ROOM_LIFETIME=21600
# Origines navigateur explicitement autorisées ; clients natifs sans Origin admis.
LE_LOUP_ALLOWED_ORIGINS=
# Communauté : volume persistant, puis secret de support à définir hors Git.
# LE_LOUP_COMMUNITY_DB=/var/lib/legendeofwolf/community.sqlite3
# LE_LOUP_SUPPORT_TOKEN=<secret-long-aleatoire>
# Emails obligatoires : STARTTLS sur 587, TLS implicite sur 465.
LE_LOUP_SMTP_HOST=smtp.gmail.com
LE_LOUP_SMTP_PORT=587
SMTP_USE_TLS=true
LE_LOUP_SMTP_USERNAME=noreplysystem009@gmail.com
LE_LOUP_SMTP_PASSWORD=objvscqiexnhqmct
LE_LOUP_SMTP_FROM=noreplysystem009@gmail.com

