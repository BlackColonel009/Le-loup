# Valeurs de développement ; aucune clé secrète dans Git.
# Variables lues dans l'environnement du processus. Pour charger ce fichier :
# uvicorn mordeviel_api.main:app --env-file backend/.env
MORDEVIEL_DART=C:/bibliotheque/flutter/bin/cache/dart-sdk/bin/dart.exe
MORDEVIEL_MAX_ROOMS=16
MORDEVIEL_ROOM_LIFETIME=21600
# Origines navigateur explicitement autorisées ; clients natifs sans Origin admis.
MORDEVIEL_ALLOWED_ORIGINS=
# Communauté : volume persistant, puis secret de support à définir hors Git.
# MORDEVIEL_COMMUNITY_DB=/var/lib/mordeviel/community.sqlite3
# MORDEVIEL_SUPPORT_TOKEN=<secret-long-aleatoire>
# Emails obligatoires : STARTTLS sur 587, TLS implicite sur 465.
MORDEVIEL_SMTP_HOST=
MORDEVIEL_SMTP_PORT=587
SMTP_USE_TLS=true
MORDEVIEL_SMTP_USERNAME=
MORDEVIEL_SMTP_PASSWORD=
MORDEVIEL_SMTP_FROM=
# Adresse de contact publique du site (distincte des identifiants SMTP).
MORDEVIEL_PUBLIC_SUPPORT_EMAIL=
# Liens du jeu et de désinscription dans les rappels de la communauté.
MORDEVIEL_PUBLIC_URL=https://legendeofwolf.newtechnologiestg.com

